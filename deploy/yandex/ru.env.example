# Settings for the Russia copy (ru.mail.cumuluscloud.app) on Yandex Cloud, region ru-central1.
# Plain values go in the container's environment. Lines marked SECRET go in Yandex Lockbox
# and are attached with `--secret` (see deploy.sh) - never in this file, the image or git.

# Runtime
PORT=8080
NODE_ENV=production
BETTER_AUTH_URL=https://ru.mail.cumuluscloud.app
MAIL_DOMAIN=cumuluscloud.app
MAIL_APP_HOST=ru.mail.cumuluscloud.app
VITE_AUTH_ENABLED=true

# Sign-in: Cumulus ID mirror that loads in Russia without a VPN (owner to confirm the host).
CID_ISSUER=https://ru.id.cumuluscloud.app
CID_CLIENT_ID=cumulus-mail

# Blobs: Yandex Object Storage (S3-compatible), sealed with MAIL_BLOB_KEY before upload.
MAIL_STORAGE=s3
MAIL_S3_ENDPOINT=https://storage.yandexcloud.net
MAIL_S3_REGION=ru-central1
MAIL_S3_BUCKET=cumulus-mail-ru

# One JSON line per request to stdout, collected by Yandex Cloud Logging (docs/deploy/logging.md).
# No bodies, no query strings, no addresses, no IP addresses. Off unless set to on.
MAIL_REQUEST_LOG=on

# SECRET  BETTER_AUTH_SECRET        random, 32+ bytes; sign-in refuses to start without it
# SECRET  DATABASE_URL              postgres://... (Managed PostgreSQL, or the shared DB - owner decision)
# SECRET  MAIL_BLOB_KEY             32 random bytes (hex or base64); must match whatever already sealed these blobs
# SECRET  MAIL_S3_ACCESS_KEY_ID     static access key of the service account with storage.editor on the bucket
# SECRET  MAIL_S3_SECRET_ACCESS_KEY
# Optional, off unless set (see docs/launch-checklist.md):
#   STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET (SECRET), MAIL_SMTP_* (password SECRET),
#   MAIL_DEFAULT_PLAN, MAIL_DKIM_SELECTOR + MAIL_DKIM_PRIVATE_KEY (SECRET)
