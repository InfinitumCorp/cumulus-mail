# Cumulus://Mail environment template. Copy to a git-ignored file OUTSIDE the repo
# (for example ~/.secrets/cumulus-mail/supabase.env, chmod 600). Never commit real values.
# Guide: docs/deploy/supabase.md

# --- Supabase Postgres -------------------------------------------------------
# Session pooler (port 5432, IPv4, keeps prepared statements): use this for the app,
# `npm run db:migrate` and the integration tests. The direct host
# db.<ref>.supabase.co:5432 is IPv6-only on the free plan. The transaction pooler
# (port 6543) is for short serverless queries only; do not run migrations through it.
# node-postgres treats sslmode=require as verify-full, so point sslrootcert at the
# Supabase Root 2021 CA (dashboard > Database > Settings > SSL, or prod-ca-2021.crt).
DATABASE_URL='postgresql://<db_user>.<project_ref>:<db_password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/path/to/prod-ca-2021.crt'
# The inbound integration test (src/lib/mail/inbound-runtime.test.ts) reads this one.
MAIL_RUNTIME_DATABASE_URL='postgresql://<db_user>.<project_ref>:<db_password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/path/to/prod-ca-2021.crt'

# --- Supabase Storage (S3-compatible) ---------------------------------------
MAIL_STORAGE=s3
# Required before the S3 driver will talk to any *.supabase.co host.
CUMULUS_ALLOW_SUPABASE=1
MAIL_S3_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/v1/s3
MAIL_S3_REGION=<project_region>
MAIL_S3_BUCKET=cumulus-mail
# 1 (default) refuses any non-loopback endpoint; 0 allows Supabase.
MAIL_S3_LOOPBACK_ONLY=0
# Dashboard only: Storage > S3 Configuration > Access keys > New access key.
MAIL_S3_ACCESS_KEY_ID=<s3_access_key_id>
MAIL_S3_SECRET_ACCESS_KEY=<s3_secret_access_key>

# --- App secrets -------------------------------------------------------------
# 32 random bytes as hex (openssl rand -hex 32). Seals every blob before upload.
MAIL_BLOB_KEY=<64_hex_chars>
BETTER_AUTH_SECRET=<random_secret>
