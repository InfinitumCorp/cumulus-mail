{
  // Incoming mail only. Do not deploy this over the live worker `cumulus-mail`.
  // Do not add send_email, R2, routes, or an addresses catch-all.
  // Deploying with `addresses` would change Email Routing. The catch-all stays
  // on `cumulus-mail` until the real-database inbound test passes.
  //
  // Secrets, set with `wrangler secret put` from this directory. Never commit values:
  //   MAIL_BLOB_KEY
  //   SUPABASE_S3_ACCESS_KEY_ID
  //   SUPABASE_S3_SECRET_ACCESS_KEY
  //
  // Hyperdrive `cumulus-mail` already exists: id d07a82ac7fcc42ac84dc6469140ef551.
  // Origin is the dedicated Mail database percackrrhhreusasspr (us-east-1), session
  // pooler aws-1-us-east-1.pooler.supabase.com port 5432. Do not use 6543.
  // Do not point this worker at the shared project ivqiskeziohbbtkcvlun.
  // The password stays in Hyperdrive. Do not commit it.
  "name": "cumulus-mail-inbound",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Server-side scheduled send: release due drafts and undo holds every minute,
  // even when no tab is open. See src/lib/mail/release.ts.
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d07a82ac7fcc42ac84dc6469140ef551"
    }
  ],
  // Keep variables set in the dashboard (MAIL_AUTH_DNS, MAIL_SMTP_*, MAIL_MAINTENANCE, MAIL_CSP, ...)
  // across deploys: without this, every workflow deploy deletes them. Values below still win.
  "keep_vars": true,
  "vars": {
    "MAIL_DOMAIN": "cumuluscloud.app",
    "MAIL_APP_HOST": "mail.cumuluscloud.app",
    "CUMULUS_ALLOW_SUPABASE": "1",
    "SUPABASE_S3_ENDPOINT": "https://percackrrhhreusasspr.storage.supabase.co/storage/v1/s3",
    "SUPABASE_S3_REGION": "us-east-1",
    "SUPABASE_S3_BUCKET": "cumulus-mail"
  }
}
