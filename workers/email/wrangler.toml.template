# Cumulus://Mail inbound worker — TEMPLATE ONLY.
# Do not deploy this file. It has no account_id, no secrets, and no routes.
# It does not create DNS or MX records for cumuluscloud.app.

name = "cumulus-mail-inbound"
main = "src/index.ts"
compatibility_date = "2026-11-07"
workers_dev = false

# Written for the Cloudflare zone cumuluscloud.app.
# Email Routing would invoke email() for that zone. The route is not declared
# here, so this template cannot attach the worker or change the zone.

[vars]
MAIL_DOMAIN = "cumuluscloud.app"
MAIL_APP_HOST = "mail.cumuluscloud.app"
